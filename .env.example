# ==============================================================
#  Achados Meli — configuração do ambiente
#  Copie este arquivo para .env e preencha com os seus dados.
#  NUNCA envie o .env para o GitHub (ele já está no .gitignore).
# ==============================================================

# URL pública do site, sem barra no final. Vazio = detecta sozinho.
# Ex.: https://achadosmeli.com.br
APP_URL=

APP_TIMEZONE=America/Sao_Paulo
APP_PER_PAGE=24

# true mostra o erro técnico na tela (use só no seu computador)
APP_DEBUG=false

# --------------------------------------------------------------
#  Banco de dados
#  DB_DRIVER: mysql  ou  sqlite (arquivo local, zero configuração)
# --------------------------------------------------------------
DB_DRIVER=mysql

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=achadosmeli
DB_USERNAME=root
DB_PASSWORD=

# SQLite (usado só quando DB_DRIVER=sqlite). Caminho relativo à raiz do projeto.
DB_SQLITE_PATH=data/achados.sqlite
